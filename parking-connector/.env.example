# Copy to .env and edit. NEVER commit .env — it is gitignored.

# Port the connector listens on.
PORT=8787

# "mock" returns demo data (no login) so you can test the app end to end.
# Switch to "live" once you've implemented fetchPlatesInside() in server.mjs.
MODE=mock

# Shared secret. Set the SAME value in ALC Valet → Settings → Connector token.
# Strongly recommended if the connector is reachable from outside localhost.
CONNECTOR_TOKEN=

# Restrict which site may call the connector (the app's origin), or * for any.
# Example: https://lokmanb194-bot.github.io
ALLOW_ORIGIN=*

# Your Aena credentials — used ONLY by your fetchPlatesInside() implementation,
# only in this process, on your own machine. Never put these in the app.
AENA_EMAIL=
AENA_PASSWORD=
